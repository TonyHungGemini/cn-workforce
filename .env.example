# Sao chép thành .env hoặc nhập trực tiếp vào Render. Không commit tệp .env.
CN_HOST=0.0.0.0
CN_DATA_DIR=/data
PORT=8080
# 0 = không tạo 48 hồ sơ minh họa khi máy chủ khởi động (bắt buộc cho dữ liệu thật).
CN_SEED_DEMO=0

# Bắt buộc khi chạy trên Internet: mã dùng chung cho nhân viên công ty.
CN_ACCESS_CODE=doi-thanh-ma-dai-va-ngau-nhien
# Bí mật ký cookie phiên. Render có thể tự sinh.
CN_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-64-ky-tu

# Chỉ dùng để đẩy snapshot ban đầu từ máy của bạn lên máy chủ.
CN_SYNC_TOKEN=doi-thanh-token-ngau-nhien-tren-32-ky-tu

# URL công khai, dùng cho Origin/Host và cookie Secure.
CN_PUBLIC_URL=https://cn-workforce.example.com

# Khoá service account Drive (ngoài repo). Quyền thực tế do thư mục/tệp chia sẻ quyết định:
# - ảnh công nhân: chỉ cần Người xem
# - tệp sao lưu cơ sở dữ liệu: cần Người chỉnh sửa
# Trên máy: đường dẫn tới tệp JSON.
CN_DRIVE_CREDENTIALS=/duong/dan/key.json
# Trên Render: dán toàn bộ nội dung tệp JSON vào biến này (ưu tiên hơn đường dẫn).
# CN_DRIVE_CREDENTIALS_JSON={"type":"service_account",...}

# Bắt buộc cho gói Free (không có ổ đĩa bền): tệp cn-workforce.sqlite3 trên Drive
# do chủ thư mục sở hữu, đã chia sẻ cho service account quyền Người chỉnh sửa.
CN_BACKUP_FILE_ID=
# Giây giữa hai lần kiểm tra thay đổi để sao lưu (tối thiểu 10).
CN_BACKUP_INTERVAL=60

# Tuỳ chọn: đồng bộ định kỳ từ ĐSX02 đã host.
CN_MASTER_URL=https://dsx02.example.com/api/records
CN_MASTER_IMAGES_URL=https://dsx02.example.com/api/images
CN_MASTER_TOKEN=
